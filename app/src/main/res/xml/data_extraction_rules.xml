<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to another phone: the settings hold the GitHub and Bannergress sign-ins -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
